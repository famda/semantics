# Ignore version control metadata
.git
.gitmodules
.gitignore

**/.venv/
**/env/
**/venv/
**/__pycache__/
**/*.pyc
**/.uv/
**/uv.lock

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore editor folders
.vscode/
.idea/

# Ignore Node and package manager folders
**/node_modules/
**/dist/
**/build/

# Ignore .NET build artifacts
src/gateway/bin/
src/gateway/obj/
src/gateway/publish/

# Ensure the .data directory is included in build contexts
.data/
